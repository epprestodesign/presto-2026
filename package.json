{
  "name": "presto-ds",
  "version": "0.1.0",
  "private": true,
  "description": "A themed Quasar component library, documented and QA'd in Storybook.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test-storybook": "test-storybook --url http://127.0.0.1:6006",
    "a11y:ci": "concurrently -k -s first -n SB,A11Y \"http-server storybook-static -p 6006 -a 127.0.0.1 -s\" \"wait-on -t 60000 tcp:127.0.0.1:6006 && pnpm test-storybook\"",
    "a11y:report": "node scripts/a11y-report.mjs"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "@quasar/extras": "^1.16.12",
    "quasar": "^2.17.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^1.9.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/test-runner": "^0.24.0",
    "@storybook/vue3-vite": "^10.4.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "axe-playwright": "^2",
    "concurrently": "^9",
    "http-server": "^14",
    "sass-embedded": "^1.83.0",
    "storybook": "^10.4.6",
    "vite": "^6.0.0",
    "wait-on": "^8"
  }
}
